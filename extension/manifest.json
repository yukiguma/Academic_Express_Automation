{
  "manifest_version": 3,
  "name": "Academic Express Auto Answer",
  "version": "1.0.0",
  "description": "Automate Academic Express matching, vocabulary, and other question types",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "*://supereigo.campus.kit.ac.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://supereigo.campus.kit.ac.jp/student/*",
        "https://supereigo.campus.kit.ac.jp/as/lplayer/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
