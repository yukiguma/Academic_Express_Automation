{
    "manifest_version": 3,
    "name": "Academic Express Automation",
    "version": "1.1.2",
    "description": "Automate Academic Express matching, vocabulary, and other question types",
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "alarms"
    ],
    "host_permissions": [
        "*://supereigo.campus.kit.ac.jp/*",
        "https://api.github.com/*"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://supereigo.campus.kit.ac.jp/*"
            ],
            "js": [
                "xhr-intercept.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://supereigo.campus.kit.ac.jp/*"
            ],
            "js": [
                "solvers.js",
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
