{
    "manifest_version": 3,
    "name": "Academic Express Auto Answer",
    "version": "1.0.0",
    "description": "Automate Academic Express matching, vocabulary, and other question types",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "*://supereigo.campus.kit.ac.jp/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://supereigo.campus.kit.ac.jp/student/*",
                "https://supereigo.campus.kit.ac.jp/as/lplayer/*"
            ],
            "js": [
                "xhr-intercept.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://supereigo.campus.kit.ac.jp/student/*",
                "https://supereigo.campus.kit.ac.jp/as/lplayer/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon16.png",
        "128": "icons/icon16.png"
    }
}